#4. regroup, rename, and rejoin output tables 
#!/bin/bash
#SBATCH --account=bXXXX
#SBATCH --partition=bXXXX
#SBATCH --job-name=humann_join_renorm
#SBATCH --mail-type=ALL
#SBATCH --mail-user=sharmi.sen@northwestern.edu
#SBATCH --nodes=1
#SBATCH --ntasks=2
#SBATCH --mem=20G
#SBATCH --time=24:00:00
#SBATCH --output=humann_join.out
#SBATCH --error=humann_join.err

module purge all
module load humann/3.9

cd sbol_Aug2025_uniref50

Echo “starting at $(date)”  
##join genefamily tables

humann_join_tables --input genefamily_tables --output sbol_genefamilies.tsv --file_name genefamilies

##join path abundance tables

humann_join_tables --input pathabundance_tables --output sbol_pathabundance.tsv --file_name pathabundance

echo “start normalizing $(date)”

##normalize all tables to relab and CPM

humann_renorm_table --input sbol_genefamilies.tsv --output sbol_genefamilies_uniref50_cpm.tsv --units cpm

humann_renorm_table --input sbol_genefamilies.tsv --output sbol_genefamilies_uniref50_relab.tsv --units relab

##normalize path abundance table to relative abundance

humann_renorm_table --input  sbol_pathabundance.tsv --output sbol_pathabundance_cpm.tsv --units cpm

humann_renorm_table --input  sbol_pathabundance.tsv --output sbol_pathabundance_relab.tsv --units relab

echo "Renaming groups" 

##rename genefamilies tables

humann_rename_table --input sbol_genefamilies_uniref50_relab.tsv --output sbol_genefamilies_relab_renamed.tsv --names uniref50

humann_rename_table --input sbol_genefamilies_cpm.tsv --output sbol_genefamilies_cpm_renamed.tsv --names uniref50

##rename pathabundance tables

humann_rename_table --input sbol_pathabundance_relab.tsv --output sbol_pathabundance_relab_renamed.tsv --names uniref50

humann_rename_table --input sbol_pathabundance_cpm.tsv --output sbol_pathabundance_cpm_renamed.tsv --names uniref50

##regroup combined genefamily table into KO groups

humann_regroup_table --input  sbol_genefamilies_relab_renamed.tsv --groups uniref50_rxn  --output sbol_genefamilies_uniref50_metacyc-relab.tsv

humann_regroup_table --input  sbol_genefamilies_relab_renamed.tsv --custom /projects/b1057/humann3_ref_data/utility_mapping/map_ko_uniref50.txt.gz \
	--output sbol_genefamilies_uniref50_ko-relab.tsv

humann_regroup_table --input  sbol_genefamilies_relab_renamed.tsv --custom /projects/b1057/humann3_ref_data/utility_mapping/map_ko_uniref50.txt.gz \
  --output sbol_genefamilies_uniref50_go-relab.tsv

humann_regroup_table --input  sbol_pathabundance_relab_renamed.tsv --groups uniref50_rxn  --output sbol_pathabundance_uniref50_metacyc-relab.tsv

humann_regroup_table --input  sbol_pathabundance_relab_renamed.tsv --custom /projects/b1057/humann3_ref_data/utility_mapping/map_ko_uniref50.txt.gz \
  --output sbol_pathabundance_uniref50_ko-relab.tsv

humann_regroup_table --input  sbol_pathabundance_relab_renamed.tsv --custom /projects/b1057/humann3_ref_data/utility_mapping/map_ko_uniref50.txt.gz \
  --output sbol_pathabundance_uniref50_go-relab.tsv

##split genefamily and path abundance tables into stratified and unstratified tables

humann_split_stratified_table --input sbol_genefamilies_uniref50_metacyc-relab.tsv --output sbol_stratified_genefamilies_metacyc

humann_split_stratified_table --input sbol_genefamilies_uniref50_ko-relab.tsv --output sbol_stratified_genefamilies_ko

humann_split_stratified_table --input sbol_genefamilies_uniref50_go-relab.tsv --output sbol_stratified_genefamilies_go

humann_split_stratified_table --input sbol_pathabundance_uniref50_ko-relab.tsv --output sbol_stratified_pathabundance_ko


humann_split_stratified_table --input sbol_pathabundance_uniref50_ko-relab.tsv --output sbol_stratified_pathabundance_ko


humann_split_stratified_table --input sbol_pathabundance_uniref50_go-relab.tsv --output sbol_stratified_pathabundance_go

echo "Finishing joining, grouping, and normalising tables $(date)"
