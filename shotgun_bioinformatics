#3. running humann
#!/bin/bash
#SBATCH --account=bXXXX
#SBATCH --partition=bXXXX 
#SBATCH --time=72:00:00 
#SBATCH --nodes=1 
#SBATCH --ntasks-per-node=32 
#SBATCH --mem=50G 
#SBATCH --job-name=humann_job 
#SBATCH --array=1-n %number of files
#SBATCH --output=humann_%a.out ## %j = job ID
#SBATCH --mail-type=ALL 
#SBATCH --mail-user=sharmi.sen@northwestern.edu  

module purge
module load humann/3.9

filename=$(sed -n "${SLURM_ARRAY_TASK_ID}p" humann_paired_input.txt)

cd /path/to/kneadcat_files

echo "Starting humann3 job"

hhumann \
  -i ${filename} \
  --threads 32 \
  --metaphlan-options "--bowtie2db /software/2025/humann/3.9/metaphlan_db" \
  --nucleotide-database /projects/b1057/humann3_ref_data/chocophlan \
  --protein-database /projects/b1057/humann3_ref_data/uniref50 \
  -o sbol_Aug2025_uniref50


echo "Finishing humann3 job for ${filename}"

