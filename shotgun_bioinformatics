#!/bin/bash
#SBATCH --account=bXXXX
#SBATCH --partition=bXXXX 
#SBATCH --time=24:00:00 
#SBATCH --nodes=1 
#SBATCH --ntasks-per-node=8 
#SBATCH --mem=50G 
#SBATCH --job-name=kneaddata_job 
#SBATCH --array=1-n %number of files
#SBATCH --output=kneaddata_%a.out ## %j = job ID
#SBATCH --mail-type=ALL 
#SBATCH --mail-user=sharmi.sen@northwestern.edu  

module purge
module load mamba/24.3.0
eval "$('/hpc/software/mamba/24.3.0/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
source "/hpc/software/mamba/24.3.0/etc/profile.d/mamba.sh"

mamba activate /gpfs/projects/b1057/sharmi/conda_envs/build_biobakery_env/biobakery_env

cd /path/to/shotgun_fastq_files

R1=$(sed -n "${SLURM_ARRAY_TASK_ID}p" R1.txt) ##saimiri_R1_fastq.txt)

R2=$(sed -n "${SLURM_ARRAY_TASK_ID}p" R2.txt) ##saimiri_R2_fastq.txt)

echo "Processing files ${R1} and ${R2}"

echo "Starting Kneaddata job"

kneaddata -i1 ${R1} -i2 ${R2} --store-temp-output -o path/to/output -s /path/to/save/scratch/files --reference-db /path/to/ncbi_dataset/data/GCF_048565385.1

echo "Finishing Kneaddata job for ${R1} and ${R2}"


#2. Concatenate filtered reads for each sample - these are the _paired1 and _paired2 fastq files from kneaddata output

cd /projects/b1057/sharmi/squirrel_monkey_project/fastq_files/kneadout_trim_Apr292025

R1=$(sed -n "${SLURM_ARRAY_TASK_ID}p" paired1_files.txt)
R2=$(sed -n "${SLURM_ARRAY_TASK_ID}p" paired2_files.txt)

cat ${R1} ${R2}  > "${R1//kneaddata_paired_1.fastq/kneadcat.fastq}"

