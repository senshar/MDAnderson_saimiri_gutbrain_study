#!/bin/bash
#SBATCH --job-name=phylotree
#SBATCH --account=b1042
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=6
#SBATCH --time=04:00:00
#SBATCH --output=tree.out
#SBATCH --error=tree.err
#SBATCH --partition=genomics
#SBATCH --mail-type=ALL 
#SBATCH --mail-user=sharmi.sen@northwestern.edu  ## your email

module purge all  
module load qiime2/2024.5-amplicon

##Build phylogenetic tree

echo "Building phylogenetic tree $(date)"

qiime phylogeny align-to-tree-mafft-fasttree --i-sequences saimiri_rep_seqs_dada2.qza \
 --o-alignment saimiri_aligned_rep_seqs_dada2_Jan2026.qza \
 --o-masked-alignment saimiri_masked_aligned_rep_seqs_dada2_Jan2026.qza \
 --o-tree saimiri_unrooted_tree_Jan2026.qza --o-rooted-tree saimiri_rooted_tree_Jan2026.qza \
 --p-n-threads 6

echo "End of phylogenetic tree building $(date)"

#!/bin/bash
#SBATCH --account=b1042
#SBATCH --partition=genomics
#SBATCH --job-name=assign_taxa
#SBATCH --output=taxa.out
#SBATCH --error=taxa.err
#SBATCH --time=4:00:00
#SBATCH --mem=50G
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=6
#SBATCH --mail-user=sharmi.sen@northwestern.edu
#SBATCH --mail-type=END

module purge all
module load qiime2/2024.5-amplicon

## Classifying ASVs taxonomically; scikit learn uses a naive bayes classifier. We use the training model here from a collection assembled by the QIIME devs.

echo "Classifying ASVs taxonomically $(date)"

qiime feature-classifier classify-sklearn --i-classifier /projects/b1057/sharmi/squirrel_monkey_project/16S_data/qiime_analysis_files/qiime_classifiers/silva-138-99-nb-classifier.qza \
 --i-reads saimiri_rep_seqs_CLEAN.qza \
 --o-classification saimiri_silva_taxonomy_Jan2026.qza \
 --p-n-jobs 1

echo "end of silva $(date)" 

qiime feature-classifier classify-sklearn --i-classifier /projects/b1057/sharmi/squirrel_monkey_project/16S_data/qiime_analysis_files/qiime_classifiers/2024.09.backbone.full-length.nb.sklearn-1.4.2.qza \
 --i-reads saimiri_rep_seqs_CLEAN.qza \
 --o-classification saimiri_gg_taxonomy_Jan2026.qza \
 --p-n-jobs 1 

echo "end of greengenes $(date)" 

qiime feature-classifier classify-sklearn --i-classifier /projects/b1057/sharmi/squirrel_monkey_project/16S_data/qiime_analysis_files/qiime_classifiers/gtdb_classifier_r220.qza \
 --i-reads saimiri_rep_seqs_CLEAN.qza \
 --o-classification /projects/b1057/sharmi/squirrel_monkey_project/16S_data/qiime_analysis_files/saimiri_gtdb_taxonomy_Jan2026.qza \
 --p-n-jobs 1

echo "end of gtdb $(date)"

## List ASVs and taxonomic assignments in table for making observations

qiime metadata tabulate --m-input-file saimiri_silva_taxonomy_Jan2026.qza \
 --o-visualization saimiri_silva_taxonomy_Jan2026.qzv

qiime metadata tabulate --m-input-file saimiri_gg_taxonomy_Jan2026.qza \
 --o-visualization saimiri_gg_taxonomy_Jan2026.qzv

qiime metadata tabulate --m-input-file saimiri_gtdb_taxonomy_Jan2026.qza \
 --o-visualization saimiri_gtdb_taxonomy_Jan2026.qzv

echo "Filter chloroplast and mitochondrial sequences $(date)"

qiime taxa filter-table --i-table saimiri_table_dada2_no-controls.qza \
 --i-taxonomy saimiri_gg_taxonomy_Jan2026.qza --p-exclude mitochondria,chloroplast \
 --o-filtered-table saimiri_gg_table_dada2_nomito_nochloro_Jan2026.qza

## Check seqs were filtered correctly

qiime feature-table summarize --i-table saimiri_gg_table_dada2_nomito_nochloro_Jan2026.qza \
 --o-visualization saimiri_gg_table_dada2_nomito_nochloro_Jan2026.qzv \
 --m-sample-metadata-file dada2_part3_metadata.tsv

echo "end of summarize and filtering $(date)" 

qiime diversity alpha-rarefaction \
 --i-table saimiri_gg_table_dada2_nomito_nochloro_Jan2026.qza \
 --i-phylogeny saimiri_rooted_tree_Jan2026.qza --o-visualization saimiri_alpha_rarefaction_curve_Jan2026.qzv --p-max-depth 15000


qiime taxa barplot --i-table saimiri_gg_table_dada2_nomito_nochloro_Jan2026.qza \
   --i-taxonomy saimiri_gg_taxonomy_Jan2026.qza \
   --m-metadata-file dada2_part3_metadata.tsv --o-visualization saimiri_taxa_bar_plots_Jan2026.qzv


