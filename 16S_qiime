#This script contains all code to analyse squirrel monkey 16S data using QIIME2 (version)

#!/bin/bash
#SBATCH --account=b1057
#SBATCH --partition=b1057
#SBATCH --job-name=qiime_summaryinfo
#SBATCH --output=qiime_summaryinfo.out
#SBATCH --error=qiime_summaryinfo.err
#SBATCH --time=10:00:00
#SBATCH --mem=30G
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=2
#SBATCH --mail-user=sharmi.sen@northwestern.edu
#SBATCH --mail-type=END

module purge all
module load qiime2/2024.5-amplicon

##step1 of qiime analyses

qiime tools import --input-path /path/to/saimiri_manifest_file_05142025.csv \
  --output-path /path/to/saimiri_summary_Jan2026.qza  \
  --type SampleData[PairedEndSequencesWithQuality] \
  --input-format PairedEndFastqManifestPhred33

echo "summarizing manifest file"

##output qza from above should be passed to --i-data
qiime demux summarize --i-data /path/to/saimiri_summary_Jan2026.qza \
 --o-visualization /path/to/saimiri_summary_Jan2026.qzv

## the next step is dada2

